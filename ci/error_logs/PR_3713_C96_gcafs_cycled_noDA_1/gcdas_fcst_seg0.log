#############################################
####  UFS Run-Time Configuration File  ######
#############################################

# ESMF #
logKindFlag:            ESMF_LOGKIND_MULTI_ON_ERROR
globalResourceControl:  true

# EARTH #
EARTH_component_list: ATM CHM
EARTH_attributes::
  Verbosity = 0
::

# ATM #
ATM_model:                      fv3
ATM_petlist_bounds:             0 29
ATM_omp_num_threads:            1
ATM_attributes::
  Verbosity = 0
::

# CHM #
CHM_model:                      gocart
CHM_petlist_bounds:             0 23
CHM_omp_num_threads:            1
CHM_attributes::
  Verbosity = 0
::

# Run Sequence #
runSeq::
  @600
    ATM phase1
    ATM -> CHM
    CHM
    CHM -> ATM
    ATM phase2
  @
