  range_warn = .true.
  reset_eta = .false.
  n_sponge = 42
  nudge_qv = .false.
  nudge_dz = .false.
  tau = 10.0
  rf_cutoff = 100.0
  d2_bg_k1 = 0.20
  d2_bg_k2 = 0.04
  kord_tm = -9
  kord_mt = 9
  kord_wz = 9
  kord_tr = 9
  hydrostatic = .false.
  phys_hydrostatic = .false.
  use_hydro_pressure = .false.
  pass_full_omega_to_physics_in_non_hydrostatic_mode = .true.
  beta = 0.
  a_imp = 1.
  p_fac = 0.1
  k_split = 1
  n_split = 4
  nwat = 6
  na_init = 1
  d_ext = 0.
  dnats = 2
  fv_sg_adj = 3600
  d2_bg = 0.
  nord = 2
  dddmp = 0.1
  d4_bg = 0.12
  vtdm4 = 0.02
  delt_max = 0.002
  ke_bg = 0.
  do_vort_damp = .true.
  external_ic = .true.
  external_eta = .true.
